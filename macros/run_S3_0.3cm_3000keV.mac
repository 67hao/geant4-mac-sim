# Paper 10.1 Benchmark - S3 @ 3000 keV, th=0.3 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S3
/DetectorConstruction/Sample_Thickness 0.3000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 3000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S3_0.3cm_3000keV
/run/beamOn 100000000
