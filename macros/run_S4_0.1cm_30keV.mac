# Paper 10.1 Benchmark - S4 @ 30 keV, th=0.1 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S4
/DetectorConstruction/Sample_Thickness 0.1000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 30 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S4_0.1cm_30keV
/run/beamOn 1000000
