# Paper 10.1 Benchmark - S7 @ 1000 keV, th=3 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S7
/DetectorConstruction/Sample_Thickness 3.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 1000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S7_3cm_1000keV
/run/beamOn 1000000
