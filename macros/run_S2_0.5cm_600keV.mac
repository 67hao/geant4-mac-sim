# Paper 10.1 Benchmark - S2 @ 600 keV, th=0.5 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S2
/DetectorConstruction/Sample_Thickness 0.5000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 600 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S2_0.5cm_600keV
/run/beamOn 1000000
