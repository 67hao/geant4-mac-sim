# Paper 10.1 Benchmark - S1 @ 30 keV, th=1 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S1
/DetectorConstruction/Sample_Thickness 1.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 30 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S1_1cm_30keV
/run/beamOn 1000000
