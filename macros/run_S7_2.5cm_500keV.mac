# Paper 10.1 Benchmark - S7 @ 500 keV, th=2.5 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S7
/DetectorConstruction/Sample_Thickness 2.5000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 500 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S7_2.5cm_500keV
/run/beamOn 1000000
