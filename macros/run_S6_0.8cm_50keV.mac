# Paper 10.1 Benchmark - S6 @ 50 keV, th=0.8 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S6
/DetectorConstruction/Sample_Thickness 0.8000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 50 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S6_0.8cm_50keV
/run/beamOn 1000000
