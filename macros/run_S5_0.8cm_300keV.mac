# Paper 10.1 Benchmark - S5 @ 300 keV, th=0.8 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S5
/DetectorConstruction/Sample_Thickness 0.8000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 300 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S5_0.8cm_300keV
/run/beamOn 100000000
