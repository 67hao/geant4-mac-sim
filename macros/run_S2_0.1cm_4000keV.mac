# Paper 10.1 Benchmark - S2 @ 4000 keV, th=0.1 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S2
/DetectorConstruction/Sample_Thickness 0.1000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 4000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S2_0.1cm_4000keV
/run/beamOn 100000000
