# Paper 10.1 Benchmark - S6 @ 2000 keV, th=2 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S6
/DetectorConstruction/Sample_Thickness 2.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 2000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S6_2cm_2000keV
/run/beamOn 1000000
