# Paper 10.1 Benchmark - S8 @ 1000 keV, th=1.5 cm
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S8
/DetectorConstruction/Sample_Thickness 1.5000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 1000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S8_1.5cm_1000keV
/run/beamOn 1000000
