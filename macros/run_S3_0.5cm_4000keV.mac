# Paper 10.1 Benchmark - S3 @ 4000 keV, th=0.5 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S3
/DetectorConstruction/Sample_Thickness 0.5000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 4000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S3_0.5cm_4000keV
/run/beamOn 100000000
