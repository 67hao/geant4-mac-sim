# Paper 10.1 Benchmark - S3 @ 5000 keV, th=2.0 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S3
/DetectorConstruction/Sample_Thickness 2.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 5000 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S3_2.0cm_5000keV
/run/beamOn 100000000
