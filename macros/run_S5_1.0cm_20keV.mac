# Paper 10.1 Benchmark - S5 @ 20 keV, th=1.0 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S5
/DetectorConstruction/Sample_Thickness 1.0000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 20 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S5_1.0cm_20keV
/run/beamOn 100000000
