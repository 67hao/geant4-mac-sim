# Paper 10.1 Benchmark - S2 @ 15 keV, th=0.005 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S2
/DetectorConstruction/Sample_Thickness 0.0050 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 15 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S2_0.005cm_15keV
/run/beamOn 100000000
