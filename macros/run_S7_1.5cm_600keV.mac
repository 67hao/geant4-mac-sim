# Paper 10.1 Benchmark - S7 @ 600 keV, th=1.5 cm (10^8 primaries)
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/DetectorConstruction/Sample_Material S7
/DetectorConstruction/Sample_Thickness 1.5000 cm
/DetectorConstruction/update

/gun/particle gamma
/gun/energy 600 keV
/gun/position 0 0 0 cm
/gun/direction 0 0 1

/analysis/setFileName hist_S7_1.5cm_600keV
/run/beamOn 100000000
